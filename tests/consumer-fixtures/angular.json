{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "button": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/button.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.build.json",
            "styles": ["node_modules/@kern-ui/angular/styles/kern.css"]
          },
          "configurations": {
            "production": {
              "aot": true,
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "extractLicenses": true
            }
          }
        }
      }
    },
