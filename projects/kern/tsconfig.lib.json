/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/kern-lib",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@kern-ui/angular/addon-charts": ["./addon-charts/src/public-api.ts"],
      "@kern-ui/angular/addon-grid": ["./addon-grid/src/public-api.ts"],
      "@kern-ui/angular/cdk": ["./cdk/src/public-api.ts"],
      "@kern-ui/angular/core": ["./core/src/public-api.ts"],
      "@kern-ui/angular/i18n": ["./i18n/src/public-api.ts"],
      "@kern-ui/angular/kit": ["./kit/src/public-api.ts"],
      "@kern-ui/angular/patterns": ["./patterns/src/public-api.ts"],
      "@kern-ui/angular/testing": ["./testing/src/public-api.ts"],
      "@kern-ui/angular/testing/actions": ["./testing/actions/src/public-api.ts"],
      "@kern-ui/angular/testing/data-display": ["./testing/data-display/src/public-api.ts"],
      "@kern-ui/angular/testing/feedback": ["./testing/feedback/src/public-api.ts"],
      "@kern-ui/angular/testing/forms": ["./testing/forms/src/public-api.ts"],
      "@kern-ui/angular/testing/layout": ["./testing/layout/src/public-api.ts"],
      "@kern-ui/angular/testing/navigation": ["./testing/navigation/src/public-api.ts"],
      "@kern-ui/angular/testing/shared": ["./testing/shared/src/public-api.ts"]
    },
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "addon-charts/src/**/*.ts",
    "addon-grid/src/**/*.ts",
    "cdk/src/**/*.ts",
    "core/src/**/*.ts",
    "i18n/src/**/*.ts",
    "kit/src/**/*.ts",
    "patterns/src/**/*.ts",
    "testing/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts"]
}
