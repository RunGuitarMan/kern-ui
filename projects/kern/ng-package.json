{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/kern",
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*",
      "output": "styles"
    },
    {
      "input": "schematics",
      "glob": "**/*",
      "output": "schematics"
    },
    {
      "input": "agent",
      "glob": "root-export-map.json",
      "output": "schematics/shared"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
