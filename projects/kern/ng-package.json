{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/kern",
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*",
      "output": "styles"
    },
    {
      "input": "schematics",
      "glob": "**/*",
      "output": "schematics"
    },
    {
      "input": "agent",
      "glob": "**/*",
      "ignore": ["**/tsconfig.json"],
      "output": "agent"
    },
    {
      "input": "mcp",
      "glob": "{lib,server}.mjs",
      "output": "mcp"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
