{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "KernCrud",
  "title": "Generate a KERN CRUD master-detail feature",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "project": {
      "type": "string",
      "$default": {
        "$source": "projectName"
      }
    },
    "path": {
      "type": "string"
    },
    "prefix": {
      "type": "string",
      "default": "app"
    },
    "flat": {
      "type": "boolean",
      "default": false
    },
    "force": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["name"]
}
