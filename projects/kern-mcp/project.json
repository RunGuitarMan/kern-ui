{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "kern-mcp",
  "projectType": "library",
  "sourceRoot": "projects/kern-mcp",
  "implicitDependencies": ["kern"],
  "tags": ["scope:kern", "type:tooling", "publishable:true"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/kern-mcp"],
      "inputs": ["production", "^production", "{workspaceRoot}/tools/build-kern-mcp-package.mjs"],
      "options": {
        "command": "node tools/build-kern-mcp-package.mjs"
      }
    }
  }
}
