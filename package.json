{
  "name": "kern-design-system-workspace",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:docs",
    "start:docs": "npm run build:kern && npm run build:showcase && ng serve docs",
    "start:lab": "npm run build:kern && npm run build:showcase && ng serve lab --port 4201",
    "start:all": "npm run build:kern && npm run build:showcase && concurrently --kill-others-on-fail --names docs,qa --prefix-colors cyan,magenta \"ng serve docs --poll 1000\" \"ng serve lab --port 4201 --poll 1000\"",
    "build": "npm run build:kern && npm run build:showcase && npm run build:docs && npm run build:lab",
    "build:kern": "ng build kern",
    "build:showcase": "ng build showcase",
    "build:docs": "ng build docs",
    "build:lab": "ng build lab",
    "watch:kern": "ng build kern --watch --configuration development",
    "test": "npm run test:schematics && npm run test:kern && npm run test:showcase && npm run test:docs && npm run test:lab",
    "test:kern": "ng test kern",
    "test:showcase": "ng test showcase",
    "test:docs": "ng test docs",
    "test:lab": "ng test lab",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:responsive": "playwright test --project=responsive",
    "test:browsers": "playwright test --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit",
    "test:schematics": "node --test tools/tests/kern-schematics.test.cjs",
    "contracts:write": "node scripts/generate-component-contract.mjs --write",
    "contracts:check": "node scripts/generate-component-contract.mjs",
    "api:baseline:write": "node tools/verify-kern-api-baseline.mjs --write",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css,json}\" \"tests/**/*.{ts,html,json,mjs}\" \"tools/**/*.{js,mjs,cjs,json}\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,md}\" package.json angular.json eslint.config.mjs playwright.config.ts",
    "verify:api": "node tools/verify-kern-api.mjs",
    "verify:api-baseline": "node tools/verify-kern-api-baseline.mjs",
    "verify:consumers": "node tools/verify-kern-consumers.mjs",
    "verify:entrypoint-boundaries": "node tools/verify-kern-entrypoint-boundaries.mjs",
    "verify:entrypoint-identity": "node tools/verify-kern-entrypoint-identity.mjs",
    "verify:source-pollution": "node tools/verify-kern-source-pollution.mjs",
    "verify:styles": "node tools/verify-kern-shared-styles.mjs",
    "verify:testing-entrypoint": "node tools/verify-kern-testing-entrypoint.mjs",
    "verify:tokens": "node tools/verify-kern-tokens.mjs",
    "typecheck:browser-tests": "tsc -p tests/tsconfig.json --pretty false",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "package:dry-run": "npm pack ./dist/kern --dry-run",
    "verify": "npm run verify:tokens && npm run contracts:check && npm run format:check && npm run lint && npm run verify:entrypoint-boundaries && npm run build:kern && npm run verify:source-pollution && npm run typecheck && npm run typecheck:browser-tests && npm run test && npm run build && npm run verify:styles && npm run verify:entrypoint-identity && npm run verify:api && npm run verify:api-baseline && npm run verify:testing-entrypoint && npm run verify:consumers && npm run package:dry-run",
    "serve:ssr:docs": "node dist/docs/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/aria": "22.0.6",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "express": "^5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/express": "^5.0.1",
    "@types/node": "26.1.2",
    "axe-core": "4.12.1",
    "concurrently": "^10.0.4",
    "eslint": "10.8.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "22.0.2",
    "prettier": "^3.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  }
}
