{
  "name": "kern-design-system-workspace",
  "version": "0.1.0",
  "scripts": {
    "start": "npm run start:docs",
    "start:docs": "nx run docs:dev",
    "serve:docs": "nx serve docs --excludeTaskDependencies",
    "build": "nx run-many -t build --all",
    "build:kern": "nx run-many -t build -p kern kern-mcp",
    "build:kern-mcp": "nx build kern-mcp",
    "build:showcase": "nx build showcase",
    "build:docs": "nx build docs",
    "watch:kern": "nx build kern --watch --configuration development",
    "watch:showcase": "nx build showcase --watch --configuration development",
    "watch:workspace": "nx watch --projects=kern,showcase -- nx build showcase --configuration development",
    "test": "npm run test:schematics && npm run test:agent && npm run test:governance && nx run kern:test-hydration && nx run-many -t test --all && nx run showcase:test-specimens",
    "test:kern": "nx run kern:test-hydration && nx test kern",
    "test:showcase": "nx test showcase && nx run showcase:test-specimens",
    "test:showcase:specimens": "nx run showcase:test-specimens",
    "test:docs": "nx test docs",
    "test:e2e": "nx run docs:e2e",
    "test:a11y": "nx run docs:a11y",
    "test:visual": "nx run docs:visual",
    "test:responsive": "nx run docs:responsive",
    "test:performance": "nx run docs:performance",
    "test:browsers": "nx run docs:browsers",
    "test:mobile-touch": "nx run docs:mobile-touch",
    "test:schematics": "node --test tools/tests/kern-schematics.test.cjs",
    "test:agent": "node --test --test-concurrency=1 tools/kern-mcp/test/*.test.mjs tools/agent-dx/*.test.mjs",
    "test:governance": "node --test tools/tests/kern-governance.test.mjs",
    "contracts:write": "node scripts/generate-component-contract.mjs --write",
    "contracts:check": "node scripts/generate-component-contract.mjs",
    "agent:examples:write": "node tools/agent-dx/generate-examples.mjs --write",
    "agent:examples:check": "node tools/agent-dx/generate-examples.mjs",
    "agent:contract:write": "node scripts/generate-agent-contract.mjs --write",
    "agent:contract:check": "node scripts/generate-agent-contract.mjs",
    "agent:showcase:write": "node scripts/generate-showcase-example-registry.mjs --write",
    "agent:showcase:check": "node scripts/generate-showcase-example-registry.mjs",
    "lifecycle:evidence:write": "node scripts/generate-lifecycle-evidence.mjs --write",
    "lifecycle:evidence:check": "node scripts/generate-lifecycle-evidence.mjs",
    "api:baseline:write": "node tools/verify-kern-api-baseline.mjs --write",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css,json}\" \"tests/**/*.{ts,html,json,mjs}\" \"tools/**/*.{js,mjs,cjs,json}\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" \".github/**/*.{yml,md}\" package.json nx.json eslint.config.mjs playwright.config.ts",
    "verify:api": "node tools/verify-kern-api.mjs",
    "verify:api-baseline": "node tools/verify-kern-api-baseline.mjs",
    "verify:component-inventory": "node tools/verify-kern-component-inventory.mjs",
    "verify:consumers": "node tools/verify-kern-consumers.mjs",
    "verify:entrypoint-boundaries": "node tools/verify-kern-entrypoint-boundaries.mjs",
    "verify:entrypoint-identity": "node tools/verify-kern-entrypoint-identity.mjs",
    "verify:source-pollution": "node tools/verify-kern-source-pollution.mjs",
    "verify:styles": "node tools/verify-kern-shared-styles.mjs",
    "verify:testing-entrypoint": "node tools/verify-kern-testing-entrypoint.mjs",
    "verify:tokens": "node tools/verify-kern-tokens.mjs",
    "verify:specimens": "node tools/verify-kern-specimen-coverage.mjs",
    "verify:playground": "node tools/verify-kern-playground-registry.mjs && node tools/sync-kern-specimen-public-api-bindings.mjs",
    "verify:agent-dx": "node tools/verify-kern-agent-dx.mjs",
    "verify:lifecycle": "npm run lifecycle:evidence:check && node tools/verify-kern-lifecycle.mjs",
    "verify:accessibility-evidence": "node tools/verify-kern-accessibility-evidence.mjs",
    "verify:package-policy": "node tools/verify-kern-package-policy.mjs",
    "verify:vite-dev": "node tools/smoke-kern-vite-dev.mjs",
    "typecheck:browser-tests": "tsc -p tests/tsconfig.json --pretty false",
    "lint": "nx run-many -t lint --all && eslint tests tools scripts",
    "typecheck": "nx run-many -t typecheck --all",
    "nx:projects": "nx show projects",
    "nx:graph": "nx graph",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test,test-hydration,test-specimens",
    "affected:lint": "nx affected -t lint",
    "package:dry-run": "npm pack ./dist/kern --dry-run && npm pack ./dist/kern-mcp --dry-run",
    "verify": "npm run verify:tokens && npm run contracts:check && npm run verify:component-inventory && npm run agent:examples:check && npm run agent:contract:check && npm run agent:showcase:check && npm run verify:specimens && npm run verify:playground && npm run format:check && npm run lint && npm run verify:entrypoint-boundaries && npm run build:kern && npm run verify:source-pollution && npm run typecheck && npm run typecheck:browser-tests && npm run test && npm run build && npm run verify:vite-dev && npm run verify:styles && npm run verify:entrypoint-identity && npm run verify:api && npm run verify:api-baseline && npm run verify:lifecycle && npm run verify:accessibility-evidence && npm run verify:package-policy && npm run verify:testing-entrypoint && npm run verify:consumers && npm run verify:agent-dx && npm run package:dry-run",
    "serve:ssr:docs": "node dist/docs/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/aria": "22.0.6",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "express": "^5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.0.8",
    "@angular-devkit/schematics": "22.0.8",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@axe-core/playwright": "4.12.1",
    "@nx/angular": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@playwright/test": "1.62.0",
    "@schematics/angular": "22.0.8",
    "@types/express": "^5.0.1",
    "@types/node": "26.1.2",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "22.0.2",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "semver": "^7.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
