{
  "name": "kern-design-system-workspace",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:docs",
    "start:docs": "npm run build:kern && npm run build:showcase && ng serve docs",
    "start:lab": "npm run build:kern && npm run build:showcase && ng serve lab --port 4201",
    "build": "npm run build:kern && npm run build:showcase && npm run build:docs && npm run build:lab",
    "build:kern": "ng build kern",
    "build:showcase": "ng build showcase",
    "build:docs": "ng build docs",
    "build:lab": "ng build lab",
    "watch:kern": "ng build kern --watch --configuration development",
    "test": "npm run test:kern && npm run test:showcase && npm run test:docs && npm run test:lab",
    "test:kern": "ng test kern",
    "test:showcase": "ng test showcase",
    "test:docs": "ng test docs",
    "test:lab": "ng test lab",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:responsive": "playwright test --project=responsive",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "package:dry-run": "npm pack ./dist/kern --dry-run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run package:dry-run",
    "serve:ssr:docs": "node dist/docs/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/aria": "22.0.6",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "express": "^5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/express": "^5.0.1",
    "@types/node": "24.13.3",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "22.0.2",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.0.8"
  }
}
