/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "@kern-ui/angular": ["./dist/kern"],
      "@kern-ui/angular/addon-charts": ["./dist/kern/addon-charts"],
      "@kern-ui/angular/addon-grid": ["./dist/kern/addon-grid"],
      "@kern-ui/angular/cdk": ["./dist/kern/cdk"],
      "@kern-ui/angular/core": ["./dist/kern/core"],
      "@kern-ui/angular/i18n": ["./dist/kern/i18n"],
      "@kern-ui/angular/kit": ["./dist/kern/kit"],
      "@kern-ui/angular/patterns": ["./dist/kern/patterns"],
      "@kern-ui/angular/testing": ["./dist/kern/testing"],
      "@kern-ui/angular/testing/actions": ["./dist/kern/testing/actions"],
      "@kern-ui/angular/testing/data-display": ["./dist/kern/testing/data-display"],
      "@kern-ui/angular/testing/feedback": ["./dist/kern/testing/feedback"],
      "@kern-ui/angular/testing/forms": ["./dist/kern/testing/forms"],
      "@kern-ui/angular/testing/layout": ["./dist/kern/testing/layout"],
      "@kern-ui/angular/testing/navigation": ["./dist/kern/testing/navigation"],
      "@kern-ui/angular/testing/shared": ["./dist/kern/testing/shared"],
      "@kern-ui/showcase": ["./dist/showcase"],
      "@kern-ui/showcase/catalog-index": ["./dist/showcase/catalog-index"],
      "@kern-ui/showcase/specimen": ["./dist/showcase/specimen"],
      "@kern-ui/showcase/examples": ["./dist/showcase/examples"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/kern/tsconfig.lib.json"
    },
    {
      "path": "./projects/kern/tsconfig.spec.json"
    },
    {
      "path": "./projects/docs/tsconfig.app.json"
    },
    {
      "path": "./projects/docs/tsconfig.spec.json"
    },
    {
      "path": "./projects/showcase/tsconfig.lib.json"
    },
    {
      "path": "./projects/showcase/tsconfig.spec.json"
    }
  ]
}
