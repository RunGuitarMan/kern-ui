{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kern-ui.dev/schemas/component-manifest.schema.json",
  "title": "KERN agent component manifest",
  "description": "Versioned, machine-readable public contract for @kern-ui/angular.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "library", "components", "symbols", "recipes", "migrations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.2.0"
    },
    "library": {
      "$ref": "#/$defs/library"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      }
    }
  },
  "$defs": {
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "framework",
        "requiredStyles",
        "configuration",
        "playground",
        "entrypoints",
        "sourceDigest"
      ],
      "properties": {
        "package": {
          "const": "@kern-ui/angular"
        },
        "version": {
          "type": "string"
        },
        "framework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "peerRange"],
          "properties": {
            "name": {
              "const": "Angular"
            },
            "peerRange": {
              "type": "string"
            }
          }
        },
        "requiredStyles": {
          "type": "string"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "required"],
          "properties": {
            "provider": {
              "const": "provideKrn"
            },
            "required": {
              "const": false
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "playground": {
          "$ref": "#/$defs/playgroundQuery"
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256-[a-f0-9]{64}$"
        }
      }
    },
    "playgroundValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "playgroundEnvironmentQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "parameter", "defaultValue", "values"],
      "properties": {
        "key": {
          "enum": ["theme", "density", "direction", "locale", "motion", "viewport"]
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "defaultValue": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "playgroundQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routePattern",
        "argumentsPrefix",
        "scenarioParameter",
        "presetParameter",
        "environment",
        "brandColor"
      ],
      "properties": {
        "routePattern": {
          "const": "preview/{componentId}"
        },
        "argumentsPrefix": {
          "const": "arg."
        },
        "scenarioParameter": {
          "const": "scenario"
        },
        "presetParameter": {
          "const": "state"
        },
        "environment": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/playgroundEnvironmentQuery"
          }
        },
        "brandColor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter", "defaultValue", "pattern"],
          "properties": {
            "parameter": {
              "const": "brandColor"
            },
            "defaultValue": {
              "const": "#4666da"
            },
            "pattern": {
              "const": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    },
    "playgroundBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "publicName"],
          "properties": {
            "kind": {
              "const": "input"
            },
            "publicName": {
              "type": "string",
              "minLength": 1
            },
            "syntax": {
              "enum": ["attribute", "property"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "publicName"],
          "properties": {
            "kind": {
              "const": "model"
            },
            "publicName": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "description"],
          "properties": {
            "kind": {
              "const": "fixture"
            },
            "target": {
              "enum": ["content", "data", "interaction", "overlay"]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "attribute"],
          "properties": {
            "kind": {
              "const": "composition"
            },
            "target": {
              "const": "canvas"
            },
            "attribute": {
              "const": "data-composition"
            }
          }
        }
      ]
    },
    "playgroundOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/playgroundValue"
        }
      }
    },
    "playgroundControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "kind", "defaultValue", "testValue", "description", "binding"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["boolean", "number", "range", "select", "text"]
        },
        "defaultValue": {
          "$ref": "#/$defs/playgroundValue"
        },
        "testValue": {
          "$ref": "#/$defs/playgroundValue"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/playgroundBinding"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/playgroundOption"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "playgroundApiExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "publicName", "kind", "type", "code", "reason", "evidence"],
      "properties": {
        "componentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "publicName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["input", "model"]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "enum": [
            "accessibility-copy",
            "callback",
            "complex-data",
            "dom-wiring",
            "form-serialization",
            "locale-environment",
            "polymorphic-value",
            "template",
            "translation-object"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "pointer"],
          "properties": {
            "category": {
              "enum": [
                "a11y-test",
                "component-example",
                "forms-integration",
                "locale-preview",
                "specimen-fixture"
              ]
            },
            "pointer": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "playgroundApiCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicInputsAndModels", "controlled", "excluded", "unclassified"],
      "properties": {
        "publicInputsAndModels": {
          "type": "integer",
          "minimum": 0
        },
        "controlled": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unclassified": {
          "const": 0
        }
      }
    },
    "playgroundEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": ["system", "light", "dark", "high-contrast"]
        },
        "density": {
          "enum": ["compact", "comfortable", "spacious"]
        },
        "direction": {
          "enum": ["ltr", "rtl"]
        },
        "viewport": {
          "enum": ["responsive", "phone", "tablet"]
        }
      }
    },
    "playgroundFixtureEffect": {
      "description": "Deterministic documentation-fixture behavior for a state that is not represented by public component bindings.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "label", "description"],
          "properties": {
            "kind": {
              "const": "layout"
            },
            "mode": {
              "enum": ["alternate", "constrained", "expanded", "overflow"]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "label", "description"],
          "properties": {
            "kind": {
              "const": "content"
            },
            "mode": {
              "enum": ["alternate", "empty", "filled", "long-text", "with-action", "without-action"]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "label", "description"],
          "properties": {
            "kind": {
              "const": "data"
            },
            "mode": {
              "enum": [
                "alternate",
                "empty",
                "error",
                "filtered",
                "loading",
                "selected",
                "sorted",
                "success",
                "virtualized"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "label", "description"],
          "properties": {
            "kind": {
              "const": "status"
            },
            "mode": {
              "enum": ["danger", "info", "neutral", "success", "warning"]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "playgroundPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scenario", "args"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "enum": ["default", "states", "stress", "virtual"]
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/playgroundValue"
          }
        },
        "environment": {
          "$ref": "#/$defs/playgroundEnvironment"
        },
        "visualPseudoState": {
          "enum": ["active", "focus-visible", "hover"]
        },
        "fixtureEffect": {
          "$ref": "#/$defs/playgroundFixtureEffect"
        }
      }
    },
    "playground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "scenarios", "controls", "presets", "apiCoverage", "exclusions"],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^preview/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["default", "states", "stress", "virtual"]
          }
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/playgroundControl"
          }
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/playgroundPreset"
          }
        },
        "apiCoverage": {
          "$ref": "#/$defs/playgroundApiCoverage"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/playgroundApiExclusion"
          }
        }
      }
    },
    "apiMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "property",
        "kind",
        "type",
        "required",
        "defaultValue",
        "description",
        "descriptionSource"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["input", "model", "output"]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "descriptionSource": {
          "enum": ["source", "curated", "inferred"]
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "selector", "required", "description"],
      "properties": {
        "name": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlValueAccessor",
        "validator",
        "valueType",
        "reactiveForms",
        "templateDrivenForms",
        "stateInputs"
      ],
      "properties": {
        "controlValueAccessor": {
          "type": "boolean"
        },
        "validator": {
          "type": "boolean"
        },
        "valueType": {
          "type": ["string", "null"]
        },
        "reactiveForms": {
          "type": "boolean"
        },
        "templateDrivenForms": {
          "type": "boolean"
        },
        "stateInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "keyboard", "notes", "manualValidationRequired"],
      "properties": {
        "target": {
          "const": "WCAG 2.2 AA"
        },
        "keyboard": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manualValidationRequired": {
          "type": "boolean"
        }
      }
    },
    "ssr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hydration", "evidenceScope", "notes"],
      "properties": {
        "status": {
          "enum": ["supported-with-consumer-validation", "browser-only"]
        },
        "hydration": {
          "enum": ["consumer-validation-required", "browser-only"]
        },
        "evidenceScope": {
          "enum": ["library-docs-route-smoke", "component-browser-evidence"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "compatibility",
        "owner",
        "evidenceProfile",
        "requiredEvidence",
        "rationale",
        "knownLimitations",
        "promotionCriteria"
      ],
      "properties": {
        "status": {
          "enum": ["stable", "beta", "experimental", "recipe", "deprecated"]
        },
        "compatibility": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidenceProfile": {
          "enum": [
            "stable-release",
            "beta-promotion",
            "experimental-incubation",
            "recipe-validation"
          ]
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "promotionCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacement": {
          "type": ["string", "null"]
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "language", "code", "verification", "source"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": ["minimal", "recipe"]
        },
        "language": {
          "enum": ["typescript", "html"]
        },
        "code": {
          "type": "string"
        },
        "verification": {
          "enum": ["contract-checked", "compiled", "manual"]
        },
        "source": {
          "type": "string",
          "description": "Artifact URL relative to component-manifest.json.",
          "pattern": "^examples/[a-z0-9]+(?:-[a-z0-9]+)*\\.ts$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "kind",
        "selector",
        "selectors",
        "symbol",
        "canonicalSymbol",
        "canonicalId",
        "owner",
        "importPath",
        "aliases",
        "summary",
        "acceptanceStates",
        "lifecycle",
        "api",
        "slots",
        "forms",
        "a11y",
        "ssr",
        "examples",
        "related",
        "keywords",
        "guidance",
        "commonMistakes",
        "checklist",
        "documentation",
        "playground"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "kind": {
          "enum": ["component", "directive"]
        },
        "selector": {
          "type": "string"
        },
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbol": {
          "type": "string"
        },
        "canonicalSymbol": {
          "type": "string"
        },
        "canonicalId": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "importPath": {
          "type": "string",
          "pattern": "^@kern-ui/angular(?:/.+)?$"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbols", "selectors", "componentIds"],
          "properties": {
            "symbols": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selectors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "componentIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "acceptanceStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "api": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/apiMember"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        },
        "forms": {
          "$ref": "#/$defs/forms"
        },
        "a11y": {
          "$ref": "#/$defs/a11y"
        },
        "ssr": {
          "$ref": "#/$defs/ssr"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["useWhen", "avoidWhen"],
          "properties": {
            "useWhen": {
              "type": "string"
            },
            "avoidWhen": {
              "type": "string"
            }
          }
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "json", "markdown"],
          "properties": {
            "route": {
              "type": "string",
              "description": "Documentation UI route relative to the deployment mount, not to component-manifest.json.",
              "pattern": "^components/[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "json": {
              "type": "string",
              "description": "Artifact URL relative to component-manifest.json.",
              "pattern": "^components/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
            },
